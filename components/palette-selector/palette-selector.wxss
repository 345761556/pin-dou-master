/* components/palette-selector/palette-selector.wxss */
/* 色卡标准选择 Tab */
.palette-tabs {
  display: flex;
  white-space: nowrap;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.palette-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-lg);
  background: var(--bg-gray);
  border: 2rpx solid transparent;
  flex-shrink: 0;
}

.palette-tab.active {
  background: var(--primary-light);
  border-color: var(--primary);
}

.tab-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.tab-count {
  font-size: 20rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.palette-tab.active .tab-name {
  color: var(--primary);
}
