/* pages/gallery/gallery.wxss */
.page-gallery {
  padding: 24rpx;
  min-height: 100vh;
}

/* 统计栏 */
.stats-bar {
  text-align: center;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.stats-text {
  font-size: 26rpx;
  color: var(--text-hint);
}

.highlight {
  color: var(--primary);
  font-weight: 700;
  font-size: 30rpx;
}

/* ===== 双列网格 ===== */
.gallery-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.gallery-card {
  padding: 0;
  overflow: hidden;
  margin-bottom: 0;
  transition: transform 0.2s var(--ease-smooth), box-shadow 0.2s var(--ease-smooth);
}

.gallery-card:active {
  transform: scale(0.97);
}

/* ===== 卡片预览区域 ===== */
.card-preview {
  position: relative;
  height: 180rpx;
  background: var(--bg-gray);
  overflow: hidden;
}

.color-strip {
  display: flex;
  height: 100%;
  width: 100%;
}

.strip-segment {
  height: 100%;
  min-width: 2rpx;
}

/* 尺寸标签（左下角） */
.card-size-badge {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #FFF;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 600;
  backdrop-filter: blur(4rpx);
}

/* 删除按钮（右上角） */
.card-delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.2s var(--ease-smooth);
}

.gallery-card:hover .card-delete-btn,
.card-delete-btn.active {
  opacity: 1;
}

.card-delete-icon {
  font-size: 24rpx;
  color: #FFF;
  font-weight: 700;
  line-height: 1;
}

/* ===== 卡片信息区 ===== */
.card-body {
  padding: 20rpx 20rpx 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.card-meta-item {
  font-size: 22rpx;
  color: var(--text-hint);
}

.card-meta-divider {
  font-size: 22rpx;
  color: var(--border-color);
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-bead-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  width: 180rpx;
  height: 180rpx;
  padding: 16rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-lg);
  box-shadow: inset 0 0 0 2rpx var(--border-color);
}

.icon-bead {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 50%;
  opacity: 0.7;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-hint);
  margin-top: 12rpx;
}
