/* pages/template/template.wxss */
.page-template {
  padding-bottom: 40rpx;
}

/* 顶部信息栏 */
.info-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #FFF;
  padding: 24rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.info-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
}

.info-label {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.info-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--border-color);
}

/* 模板画布 */
.canvas-wrapper {
  margin: 24rpx;
  padding: 24rpx;
}

.canvas-header {
  margin-bottom: 20rpx;
}

.zoom-controls {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.zoom-btn {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.zoom-btn:active {
  background: var(--bg-light);
}

.zoom-level {
  font-size: 26rpx;
  color: var(--text-secondary);
  min-width: 60rpx;
  text-align: center;
}

/* 预览缩放低于导出最低清晰度时的澄清提示 */
.label-hint {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(24, 144, 255, 0.06);
  border-radius: var(--radius-md);
}

.label-hint-icon {
  font-size: 26rpx;
  flex-shrink: 0;
  line-height: 1.5;
}

.label-hint-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.canvas-scroll {
  width: 100%;
  height: 600rpx;
  background: #F0F0F0;
  border-radius: var(--radius-md);
  overflow: hidden;
}

/* 对照原图 */
.compare-toggle {
  text-align: center;
  padding: 20rpx;
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
}

.compare-image {
  width: 100%;
  height: 400rpx;
  border-radius: var(--radius-md);
  background: #F0F0F0;
}

/* 操作按钮 */
.action-bar {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  background: #FFF;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  flex: 1;
}

.action-btn:active {
  background: var(--bg-light);
}

.action-icon {
  font-size: 40rpx;
}

.action-btn text:last-child {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 小贴士 */
.tips-card {
  margin: 0 24rpx 24rpx;
}

.tip-list {
  padding: 0 8rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 12rpx 0;
}

.tip-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}
