/* pages/index/index.wxss */
.page-index {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* ===== 轻量头部 ===== */
.app-header {
  margin-bottom: 24rpx;
  padding: 32rpx 8rpx;
}

.app-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
  display: block;
  letter-spacing: 2rpx;
}

.app-subtitle {
  font-size: 26rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
  display: block;
}

/* ===== 步骤卡片 ===== */
.step-card {
  margin-bottom: 24rpx;
}

.step-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.step-indicator {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--primary-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.step-num {
  font-size: 22rpx;
  font-weight: 700;
  color: #FFF;
}

.step-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ===== 上传区域 ===== */
.upload-area {
  border: 4rpx dashed var(--border-color);
  border-radius: var(--radius-lg);
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--bg-gray);
  transition: all 0.3s var(--ease-smooth);
}

.upload-area:active {
  background: var(--bg-light);
  border-color: var(--primary-light);
}

/* CSS 相机图标 */
.upload-icon-wrap {
  margin-bottom: 24rpx;
}

.icon-camera-body {
  width: 80rpx;
  height: 64rpx;
  background: var(--text-hint);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  opacity: 0.4;
}

.icon-camera-body::before {
  content: '';
  width: 24rpx;
  height: 8rpx;
  background: var(--text-hint);
  position: absolute;
  top: -8rpx;
  border-radius: 4rpx 4rpx 0 0;
}

.icon-camera-lens {
  width: 32rpx;
  height: 32rpx;
  background: var(--bg-gray);
  border: 5rpx solid #CCC;
  border-radius: 50%;
}

.upload-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.upload-hint {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 12rpx;
}

/* ===== 图片预览 ===== */
.preview-area {
  position: relative;
}

.preview-image {
  width: 100%;
  height: 440rpx;
  border-radius: var(--radius-md);
  background: var(--bg-light);
}

.preview-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.action-btn {
  padding: 12rpx 32rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-xl);
  font-size: 26rpx;
  color: var(--text-secondary);
}

.action-btn:active {
  background: var(--bg-light);
}

/* ===== 参数区域 ===== */
.param-section {
  padding: 0;
}

.param-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.param-row:last-child {
  border-bottom: none;
}

.param-label {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  min-width: 140rpx;
  flex-shrink: 0;
}

.param-label-col {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  margin-right: 16rpx;
}

.param-hint {
  font-size: 22rpx;
  color: var(--text-hint);
  line-height: 1.3;
}

.param-control {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
}

.param-value {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.param-value-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.param-value .arrow {
  margin-left: 8rpx;
  font-size: 36rpx;
  color: var(--text-hint);
}

/* 色卡预览圆点 */
.palette-dot-row {
  display: flex;
  gap: 4rpx;
  margin-right: 12rpx;
  align-items: center;
}

.palette-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.width-slider {
  width: 280rpx;
  margin-right: 12rpx;
}

.slider-unit {
  font-size: 24rpx;
  color: var(--text-hint);
  min-width: 50rpx;
}

/* ===== 形状选择器 ===== */
.shape-selector {
  display: flex;
  gap: 16rpx;
}

.shape-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: 26rpx;
  color: var(--text-secondary);
  transition: all 0.2s var(--ease-smooth);
}

.shape-option.active {
  border-color: var(--primary);
  color: var(--primary);
  background: rgba(255, 107, 107, 0.05);
}

.shape-icon {
  width: 32rpx;
  height: 32rpx;
}

.square-icon {
  background: currentColor;
  border-radius: 4rpx;
}

.circle-icon {
  background: currentColor;
  border-radius: 50%;
}

/* ===== 高级选项折叠 ===== */
.advanced-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 0;
  gap: 8rpx;
}

.advanced-toggle-text {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
  line-height: 36rpx;
}

.advanced-toggle-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26rpx;
  height: 36rpx;
  font-size: 26rpx;
  color: var(--primary);
  transition: transform 0.25s var(--ease-smooth);
  /* › 字形在字体中视觉上偏上，整体下移做光学对齐 */
  transform: translateY(4rpx);
}

.advanced-toggle-arrow.open {
  transform: translateY(4rpx) rotate(90deg);
}

/* 高级参数区域 - 折叠动画 */
.advanced-section {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s var(--ease-smooth);
}

.advanced-section.open {
  max-height: 600rpx;
}

.advanced-section .param-row:first-child {
  padding-top: 24rpx;
}

/* ===== 生成按钮 ===== */
.generate-section {
  padding: 0;
  margin-top: 16rpx;
}

.generate-btn {
  width: 100%;
  padding: 30rpx;
  font-size: 34rpx;
}

.generate-btn.disabled {
  opacity: 0.7;
}

/* ===== 预估信息 ===== */
.estimate-info {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
}

.estimate-text {
  font-size: 24rpx;
  color: var(--text-hint);
}

.estimate-divider {
  font-size: 24rpx;
  color: var(--border-color);
}

.highlight {
  color: var(--primary);
  font-weight: 700;
}

/* ===== 隐私弹窗 ===== */
.privacy-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-content {
  width: 600rpx;
  background: #FFF;
  border-radius: var(--radius-lg);
  padding: 48rpx;
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 24rpx;
  text-align: center;
}

.privacy-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  display: block;
  margin-bottom: 40rpx;
}

.privacy-buttons {
  display: flex;
  gap: 24rpx;
}

.privacy-reject {
  flex: 1;
  padding: 20rpx;
  font-size: 28rpx;
  background: var(--bg-light);
  color: var(--text-secondary);
  border: none;
  border-radius: var(--radius-xl);
}

.privacy-agree {
  flex: 1;
  padding: 20rpx;
  font-size: 28rpx;
  background: var(--primary);
  color: #FFF;
  border: none;
  border-radius: var(--radius-xl);
}

/* ===== 色卡弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  width: 100%;
  max-height: 80vh;
  background: #FFF;
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: 32rpx;
}

.modal-content-large {
  max-height: 85vh;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 24rpx;
  display: block;
}

.color-grid-scroll {
  max-height: 60vh;
}

.color-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx;
}

.color-chip {
  width: calc(25% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-md);
}

.chip-color {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.08);
  margin-bottom: 8rpx;
}

.chip-name {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.chip-id {
  font-size: 22rpx;
  color: var(--text-hint);
}

.modal-close {
  text-align: center;
  padding: 32rpx;
  font-size: 30rpx;
  color: var(--primary);
  font-weight: 600;
}
